# Copy to .env and fill in. Never commit .env.

# Self-hosted Flagsmith (Docker). API base URL, including /api/v1/.
# The simulator sends experiment events to /api/v1/events/ on this same API.
# Leave unset on Render until the public SDK URL is available.
FLAGSMITH_API_URL=http://localhost:8000/api/v1/

# Organisation admin API key for Flagsmith setup and experiment scripts.
FLAGSMITH_ADMIN_API_KEY=

# Production client-side key, also used for an explicit simulator --environment Production run.
CODEFLOW_FLAGSMITH_ENV_KEY=

# Server-side key for Flagsmith mode. Use Development on develop/dev deploys
# and Production on main/prod deploys. Secret. Leave unset on Render for now.
CODEFLOW_FLAGSMITH_SERVER_KEY=

# Optional flag scope file. Defaults to flagsmith_scopes.json in CODEFLOW_DATA_DIR.
CODEFLOW_FLAGSMITH_SCOPES_PATH=

# Environment for simulations and experiment scripts.
# Populate both with make flagsmith-setup-sim.
CODEFLOW_SIM_ENVIRONMENT=Development
CODEFLOW_SIM_FLAGSMITH_ENV_KEY=

# Where analyzer output (snapshots, diffs) is stored
CODEFLOW_DATA_DIR=./data

# Minimum number of call layers for the server to classify a diff as a long flow
CODEFLOW_LONG_FLOW_MIN_DEPTH=4

# Maximum commits to analyze per GitHub import and retain on refresh (1–200).
# Render uses 50. The local default is 200.
CODEFLOW_MAX_IMPORT_COMMITS=200

# Number of decoded graph snapshots cached by the API (default 16).
# Render uses 8.
CODEFLOW_SNAPSHOT_CACHE_SIZE=16

# Docker listener. Render supplies PORT. The container defaults to 8787.
PORT=8787

# Web app -> server
# Use VITE_API_URL=/ for Sign in with GitHub: the web app then calls /api on its own
# origin, which Vite (locally) or the Pages Function (hosted) forwards to the API.
# Without sign-in, it can be the API origin without /api.
# On Render, set CODEFLOW_WEB_ORIGIN to the Pages HTTPS origin without a trailing slash.
VITE_API_URL=http://localhost:8787
CODEFLOW_WEB_ORIGIN=http://localhost:5173
# Where the Vite dev server forwards /api (default http://localhost:8787).
CODEFLOW_API_PROXY=

# Sign in with GitHub (docs/GITHUB_SIGNIN.md). Set all of these or none.
# Use a separate GitHub App for local development and for the hosted site.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
# Secret.
GITHUB_CLIENT_SECRET=
# The app's private key: a path to the .pem file locally, or (secret) the PEM text
# or its base64 in GITHUB_APP_PRIVATE_KEY on Render.
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_PRIVATE_KEY=
# Private imports each signed-in person may keep on this server (default 3).
CODEFLOW_MAX_PRIVATE_IMPORTS=3
# Local only: a read-only fine-grained token for cloning private repos by URL.
# The API refuses to start with it unless CODEFLOW_WEB_ORIGIN is localhost. Secret.
CODEFLOW_GITHUB_TOKEN=
# Optional. Raises GitHub's rate limit (60 an hour per address without a token) for the
# branch list and commits of public repos. Use a fine-grained token that can read public
# repositories only, so a token leak or misconfiguration cannot expose private ones. Secret.
CODEFLOW_GITHUB_API_TOKEN=
# Arm shown when Flagsmith is unavailable: url_import (default) or github_signin.
VITE_GITHUB_SIGNIN_FALLBACK=url_import
# Set to 1 for the Pages build to show the hosted note and retry cold starts.
VITE_HOSTED_DEMO=0

# Leave both VITE Flagsmith values unset on Pages until the SDK URL is public.
VITE_FLAGSMITH_API_URL=http://localhost:8000/api/v1/
# Web client key. On develop/dev deploys, copy the Development value of
# CODEFLOW_SIM_FLAGSMITH_ENV_KEY written by make flagsmith-setup-sim. Development
# enables variant_preview. On main/prod deploys, use the Production client key.
# Production disables variant_preview and serves the rolled-out versions.
# For local web builds, this value can also go in a gitignored repo-root
# .env.development.local or .env.production.local. Keep keys out of Git.
VITE_CODEFLOW_FLAGSMITH_ENV_KEY=

# Optional LLM for the one-line summary (rule-based summary is used when unset)
CODEFLOW_LLM_PROVIDER=
