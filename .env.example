# Copy to .env and fill in. Never commit .env.

# Self-hosted Flagsmith (Docker). API base URL, including /api/v1/.
# The simulator sends experiment events to /api/v1/events/ on this same API.
FLAGSMITH_API_URL=http://localhost:8000/api/v1/

# Organisation admin API key for Flagsmith setup and experiment scripts.
FLAGSMITH_ADMIN_API_KEY=

# Production client-side key, also used for an explicit simulator --environment Production run.
CODEFLOW_FLAGSMITH_ENV_KEY=

# Server-side key for Flagsmith mode. Use Development on develop/dev deploys
# and Production on main/prod deploys.
CODEFLOW_FLAGSMITH_SERVER_KEY=

# Environment for simulations and experiment scripts.
# Populate both with make flagsmith-setup-sim.
CODEFLOW_SIM_ENVIRONMENT=Development
CODEFLOW_SIM_FLAGSMITH_ENV_KEY=

# Where analyzer output (snapshots, diffs) is stored
CODEFLOW_DATA_DIR=./data

# Minimum number of call layers for the server to classify a diff as a long flow
CODEFLOW_LONG_FLOW_MIN_DEPTH=4

# Seconds between automatic GitHub refreshes (default 300, minimum 10)
CODEFLOW_AUTO_SYNC_INTERVAL_SECONDS=300

# Web app -> server
VITE_API_URL=http://localhost:8787
CODEFLOW_WEB_ORIGIN=http://localhost:5173
VITE_FLAGSMITH_API_URL=http://localhost:8000/api/v1/
# Web client key. On develop/dev deploys, copy the Development value of
# CODEFLOW_SIM_FLAGSMITH_ENV_KEY written by make flagsmith-setup-sim. Development
# enables variant_preview. On main/prod deploys, use the Production client key.
# Production disables variant_preview and serves the rolled-out versions.
# For local web builds, this value can also go in a gitignored repo-root
# .env.development.local or .env.production.local. Keep keys out of Git.
VITE_CODEFLOW_FLAGSMITH_ENV_KEY=

# Optional LLM for the one-line summary (rule-based summary is used when unset)
CODEFLOW_LLM_PROVIDER=
